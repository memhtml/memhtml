{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "//#lint:md": {
      "inputs": ["**/*.md", "dprint.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@memhtml/html#test": {
      "dependsOn": ["build", "@memhtml/index#build"],
      "outputs": []
    },
    "@memhtml/cli#test": {
      "dependsOn": ["build", "@memhtml/mcp#build"],
      "outputs": []
    },
    "@memhtml/docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "public/d2/**"]
    },
    "@memhtml/docs#test": {
      "dependsOn": ["build", "typecheck"],
      "outputs": []
    },
    "test:a11y": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:budget": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build", "@memhtml/mcp#build"],
      "cache": false
    },
    "test:eval": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
