{
  "name": "@memhtml/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The `memhtml-mcp` stdio server.",
  "bin": {
    "memhtml-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bin": {
      "types": "./dist/bin.d.ts",
      "default": "./dist/bin.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check src tests",
    "test": "vitest run",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@memhtml/cli": "workspace:*",
    "@memhtml/contracts": "workspace:*",
    "@memhtml/domain": "workspace:*",
    "@memhtml/html": "workspace:*",
    "@memhtml/index": "workspace:*",
    "@memhtml/llm": "workspace:*",
    "@memhtml/sleep": "workspace:*",
    "@memhtml/store": "workspace:*",
    "@memhtml/traces": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@effect/vitest": "catalog:",
    "@types/node": "24.10.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
