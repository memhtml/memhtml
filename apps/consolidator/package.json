{
  "name": "@memhtml/consolidator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The eve agent that distills candidate memories from raw transcripts.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check src tests",
    "test": "vitest run",
    "build:agent": "eve build",
    "dev:agent": "eve dev"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.51",
    "@memhtml/contracts": "workspace:*",
    "ai": "7.0.59",
    "effect": "catalog:",
    "eve": "0.32.0",
    "just-bash": "3.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@effect/vitest": "catalog:",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
