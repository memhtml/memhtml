{
  "name": "@memhtml/consolidator",
  "version": "0.7.0",
  "private": true,
  "description": "The eve agent that distills candidate memories from raw transcripts.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memhtml/memhtml.git",
    "directory": "apps/consolidator"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "agent",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check src tests",
    "test": "vitest run",
    "build:agent": "eve build",
    "dev:agent": "eve dev"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.61",
    "@memhtml/contracts": "workspace:*",
    "ai": "7.0.77",
    "effect": "catalog:",
    "eve": "0.44.1",
    "just-bash": "3.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@effect/vitest": "catalog:",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
