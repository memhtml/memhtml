{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "url": [
        "/",
        "/learn/tutorial/first-memory/",
        "/reference/rrf-arms/",
        "/internals/the-memory-file-format/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2", "canonical"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "optimistic"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 120000,
            "aggregationMethod": "pessimistic"
          }
        ],
        "unminified-css": "error",
        "unminified-javascript": "error"
      }
    }
  }
}
