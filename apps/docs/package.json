{
  "name": "@memhtml/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "gen:icons": "node src/branding/write-icons.ts",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:budget": "CHROME_PATH=$(node -p 'require(\"playwright\").chromium.executablePath()') lhci autorun",
    "spellcheck": "cspell --no-progress \"src/content/**\"",
    "lint": "biome check src tests astro.config.ts vitest.config.ts vitest.a11y.config.ts cspell.json lighthouserc.json --no-errors-on-unmatched && pnpm run spellcheck"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.5",
    "@astrojs/starlight": "^0.41.7",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@memhtml/cli": "workspace:*",
    "@tabler/icons-astro": "^3.46.0",
    "astro": "^7.2.1",
    "astro-d2": "^0.13.1",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "satteri": "^0.9.5",
    "starlight-base-path": "^0.2.1",
    "starlight-heading-badges": "^0.8.0",
    "starlight-links-validator": "^0.25.2",
    "starlight-llms-txt": "^0.11.0",
    "starlight-md-txt": "^0.1.0",
    "starlight-package-managers": "^0.12.0",
    "starlight-scroll-to-top": "^1.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.8",
    "@expo-google-fonts/tinos": "^0.4.2",
    "@lhci/cli": "^0.15.1",
    "@types/hast": "^3.0.5",
    "@types/node": "26.2.0",
    "cspell": "^10.0.1",
    "playwright": "^1.62.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
