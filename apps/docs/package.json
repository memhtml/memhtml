{
  "name": "@memhtml/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "gen:icons": "node src/branding/write-icons.ts",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "spellcheck": "cspell --no-progress \"src/content/**\"",
    "lint": "biome check src tests astro.config.ts vitest.config.ts vitest.a11y.config.ts cspell.json --no-errors-on-unmatched && pnpm run spellcheck"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/starlight": "^0.42.9",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@memhtml/cli": "workspace:*",
    "@tabler/icons-astro": "^3.50.0",
    "astro": "^7.4.7",
    "astro-d2": "^0.14.0",
    "astro-og-canvas": "^0.13.3",
    "canvaskit-wasm": "^0.42.0",
    "satteri": "^0.11.6",
    "starlight-base-path": "^0.2.1",
    "starlight-heading-badges": "^0.8.0",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-md-txt": "^0.1.0",
    "starlight-scroll-to-top": "^2.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.6",
    "@expo-google-fonts/tinos": "^0.4.2",
    "@types/hast": "^3.0.5",
    "@types/node": "26.6.6",
    "cspell": "^10.4.0",
    "mdast-util-to-hast": "^13.2.1",
    "playwright": "^1.65.0",
    "starlight-typedoc": "^0.23.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
