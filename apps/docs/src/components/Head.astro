---
import Default from "@astrojs/starlight/components/Head.astro"

import { APPLE_TOUCH_SIZE, ICON_PNG_SIZE, ICO_SIZES } from "../branding/mark.ts"
import { ogAlt, ogSlug, OG_HEIGHT, OG_WIDTH } from "../branding/og-card.ts"

/*
 * The head, extended with this page's social card and the raster icons.
 *
 * Every URL here is built with `new URL()` over `import.meta.env.BASE_URL`, never by concatenating
 * strings. `Astro.site` EXCLUDES the base — `https://memhtml.github.io` — so resolving a path
 * against it directly drops the `/memhtml` segment and produces a 404 that only shows up in
 * production. `BASE_URL` is the accessor that includes it, and the trailing slash is normalised
 * because `new URL("og/x", ".../memhtml")` would otherwise resolve the base segment away.
 *
 * The raster icons are emitted BEFORE the default head on purpose. Starlight sorts its own
 * `<link rel="shortcut icon">` to the end so that a browser choosing between equally applicable
 * icons takes the SVG, which is the one that stays sharp at any scale; a PNG declared after it
 * would win that choice instead.
 */

const base = import.meta.env.BASE_URL
const baseSegment = base.endsWith("/") ? base : `${base}/`

/*
 * An icon is a same-site asset and stays root-relative, so a preview build served from another host
 * does not fetch its icons from production. `new URL` needs some origin to resolve against, and only
 * the pathname is read back out of it — which is still a URL resolution rather than a concatenation,
 * so the base segment cannot be doubled or dropped.
 */
const asset = (file: string): string =>
  new URL(file, new URL(baseSegment, "https://assets.invalid")).pathname

/* `og:image` is the one URL that must be absolute: a crawler resolves it against nothing. */
const { entry } = Astro.locals.starlightRoute
const card = new URL(ogSlug(entry.id), new URL("og/", new URL(baseSegment, Astro.site)))

const icoSizes = ICO_SIZES.map((size) => `${size}x${size}`).join(" ")
const appleTouch = `${APPLE_TOUCH_SIZE}x${APPLE_TOUCH_SIZE}`
---

<link rel="icon" href={asset("favicon.ico")} sizes={icoSizes} />
<link
  rel="icon"
  type="image/png"
  href={asset(`icon-${ICON_PNG_SIZE}.png`)}
  sizes={`${ICON_PNG_SIZE}x${ICON_PNG_SIZE}`}
/>
<link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} sizes={appleTouch} />

<Default />

<meta property="og:image" content={card} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:alt" content={ogAlt(entry.data.title)} />
<meta name="twitter:image" content={card} />
<meta name="twitter:image:alt" content={ogAlt(entry.data.title)} />
