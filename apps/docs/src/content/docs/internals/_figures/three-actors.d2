# Also rendered to a monospace figure for the README — short ASCII-only labels are for that renderer.
...@_register

direction: down

agent: the agent {class: door}
main: main {class: record}
curator: the curator {class: step}
branch: "curate/<date>" {class: record}
review: the human {class: door}

agent -> main: writes
main -> curator: reads
curator -> branch: commits
branch -> review: review
review -> main: merge
