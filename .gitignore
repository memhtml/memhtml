node_modules/
dist/
dist-check/
coverage/
.turbo/
# Astro's generated types and dev cache. It holds a dev.json carrying a live PID, which is also
# why it is not a turbo output: a restored cache makes `astro dev` refuse to start.
.astro/
*.tsbuildinfo
.env
.env.local
.erpaval/sessions/
.codegraph/
docs/.repomix/
# mise.toml and mise.lock are committed — these two are the per-machine overrides.
mise.local.toml
mise.local.lock
# Scanner output. The durable copy is the SARIF uploaded to code scanning.
.sarif/
# Lighthouse CI's reports, and the directory that exists only to expose `dist/` at the base segment
# the site is built with — `staticDistDir` serves its argument at the root, and the site's own asset
# URLs are `/memhtml/…`, so the served tree needs that one directory above the output.
.lighthouseci/
.lhci-site/
# The typecheck-gate test builds here so a run never leaves dist/ describing its broken probe.
dist-typecheck-probe/
