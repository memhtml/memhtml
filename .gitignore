node_modules/
dist/
dist-check/
# The assembled single package: tsdown bundles the workspace and
# scripts/package-manifest.mjs writes its manifest, rebuilt by `mise run package:assemble`.
dist-package/
coverage/
.turbo/
# Astro's generated types and dev cache. It holds a dev.json carrying a live PID, which is also
# why it is not a turbo output: a restored cache makes `astro dev` refuse to start.
.astro/
*.tsbuildinfo
.env
.env.local
.lessons/sessions/
.codegraph/
docs/.repomix/
# Agent scratch from a codebase-understanding pass: derived analysis of the tree, not an artifact of
# the system. The durable version of anything worth keeping is a file under docs/ proper.
docs/.packets/
# Working directories a generator leaves under docs/codebase/ while it builds the pages: its
# scratch, not pages, and not an artifact of the system.
docs/codebase/.*/
# mise.toml and mise.lock are committed — these two are the per-machine overrides.
mise.local.toml
mise.local.lock
# Scanner output. The durable copy is the SARIF uploaded to code scanning.
.sarif/
.sbom/
# The typecheck-gate test builds here so a run never leaves dist/ describing its broken probe.
dist-typecheck-probe/
# astro-d2 renders each figure into public/ during `astro build`, from the committed `.d2` sources under
# apps/docs/src/content/docs/internals/_figures/. The source is the .d2 file; the SVG is a build output,
# declared as one in turbo.json so a cache hit restores it.
apps/docs/public/d2/
# starlight-typedoc writes the API tier here, one directory per package, from the TSDoc during `astro check`
# and `astro build`. The source is the TSDoc; the Markdown is a build output. `api/index.md` is authored.
apps/docs/src/content/docs/api/*/
