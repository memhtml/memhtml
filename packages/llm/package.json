{
  "name": "@memhtml/llm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bedrock embeddings and structured output.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1099.0",
    "@aws/bedrock-token-generator": "1.1.0",
    "@memhtml/contracts": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@effect/vitest": "catalog:",
    "@types/node": "24.10.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
