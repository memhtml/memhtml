{
  "name": "@memhtml/traces",
  "version": "0.11.2",
  "private": true,
  "description": "Streaming JSONL parser and trace indexer.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memhtml/memhtml.git",
    "directory": "packages/traces"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@memhtml/contracts": "workspace:*",
    "@memhtml/index": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@effect/vitest": "catalog:",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
