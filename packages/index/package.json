{
  "name": "@memhtml/index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQLite schema, migrations, the git-driven indexer, and four-arm retrieval.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
