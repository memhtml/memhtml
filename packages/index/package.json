    "effect": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@effect/vitest": "catalog:",
    "@memhtml/store": "workspace:*",
    "@types/node": "24.13.3",
    "fast-check": "catalog:",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
