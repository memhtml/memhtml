{
  "name": "@memhtml/eval",
  "version": "0.14.0",
  "private": true,
  "description": "Fixture corpus generator, the refusable retrieval discrimination gate, and the write-path discrimination arm.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memhtml/memhtml.git",
    "directory": "packages/eval"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check src tests eval",
    "test": "vitest run",
    "test:eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@memhtml/consolidator": "workspace:*",
    "@memhtml/contracts": "workspace:*",
    "@memhtml/domain": "workspace:*",
    "@memhtml/html": "workspace:*",
    "@memhtml/index": "workspace:*",
    "@memhtml/llm": "workspace:*",
    "@memhtml/sleep": "workspace:*",
    "@memhtml/store": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@effect/vitest": "catalog:",
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
