{
  "name": "@memhtml/curator",
  "version": "0.15.1",
  "private": true,
  "description": "The curator memhtml itself owns: a bounded model-driven tool loop over a curator session, its charter, its budget, and its model factory.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "prompts",
    "!dist/.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.88",
    "@ai-sdk/openai-compatible": "3.0.53",
    "@ai-sdk/provider": "4.0.17",
    "@aws-sdk/credential-providers": "3.1101.0",
    "@memhtml/contracts": "workspace:*",
    "@memhtml/domain": "workspace:*",
    "@memhtml/head": "workspace:*",
    "@memhtml/html": "workspace:*",
    "@memhtml/llm": "workspace:*",
    "@memhtml/session": "workspace:*",
    "ai": "7.0.107",
    "effect": "catalog:",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-metrics": "2.4.2",
    "graphology-types": "0.24.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/vitest": "catalog:",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
