{
  "name": "@memhtml/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schemas, enums, errors, and path algebra. Zero I/O.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./edges": {
      "types": "./dist/edges.d.ts",
      "default": "./dist/edges.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./slug": {
      "types": "./dist/slug.d.ts",
      "default": "./dist/slug.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@effect/vitest": "catalog:",
    "@types/node": "24.13.3",
    "fast-check": "catalog:",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
