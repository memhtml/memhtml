{
  "name": "memhtml",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:eval": "turbo run test:eval",
    "figures:readme": "node scripts/readme-figures.mjs",
    "test:a11y": "turbo run test:a11y",
    "test:budget": "turbo run test:budget",
    "gen:fixture": "turbo run build --filter=@memhtml/eval && node packages/eval/dist/gen-fixture.js",
    "check": "turbo run lint typecheck test test:integration test:eval test:a11y test:budget"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "effect": "catalog:",
    "turbo": "2.10.9",
    "typescript": "7.0.2"
  }
}
